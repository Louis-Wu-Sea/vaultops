  "description": "Claude Code plugin for Obsidian-based task management — 43 MCP tools, 27 slash commands, TUI dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Louis-Wu-Sea/vaultops.git"
  },
  "homepage": "https://github.com/Louis-Wu-Sea/vaultops",
  "bugs": {
